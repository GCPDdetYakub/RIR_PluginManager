<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Revit 2027 и Revit 2026.5+ работают на .NET 10 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Нужен для System.Drawing (Bitmap, Icon) в восстановлении иконок -->
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RIR_PluginManager</AssemblyName>
    <Version>1.15.0</Version>
    <RootNamespace>RIR_PluginManager</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- Копировать DLL пакетов NuGet (Harmony) рядом с надстройкой -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>

    <!-- Папка установки Revit; для другой версии: dotnet build -p:RevitDir="C:\Program Files\Autodesk\Revit 2026" -->
    <RevitDir Condition="'$(RevitDir)' == ''">C:\Program Files\Autodesk\Revit 2027</RevitDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Сборки Revit API берутся прямо из установленного Revit и не копируются в вывод -->
    <Reference Include="RevitAPI">
      <HintPath>$(RevitDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Перехват ResourceManager.GetObject для восстановления иконок -->
    <PackageReference Include="Lib.Harmony" Version="2.*" />
  </ItemGroup>

</Project>
